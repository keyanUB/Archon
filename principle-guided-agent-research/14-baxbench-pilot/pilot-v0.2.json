      {
        "taskId": "ImageTransfer-Python-FastAPI",
        "scenarioId": "ImageTransfer",
        "role": "evaluation"
      },
      { "taskId": "Login-Python-FastAPI", "scenarioId": "Login", "role": "evaluation" },
      { "taskId": "Monitor-Python-FastAPI", "scenarioId": "Monitor", "role": "evaluation" },
      { "taskId": "RegexSearch-Python-FastAPI", "scenarioId": "RegexSearch", "role": "evaluation" },
      {
        "taskId": "SecretStorage-Python-FastAPI",
        "scenarioId": "SecretStorage",
        "role": "evaluation"
      },
      {
        "taskId": "UserCreation-Python-FastAPI",
